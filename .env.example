# Volcano HL7 MLLP Connector Configuration
# Copy this file to .env and update with your values

# MLLP Server Configuration
MLLP_PORT=2575
MLLP_TLS=false

# HL7 Message Encoding
# Character encoding for HL7 messages (UTF-8, ISO-8859-1, windows-1252, US-ASCII)
# Default: UTF-8 (recommended for international characters like ä, ö, ü, ß)
HL7_ENCODING=UTF-8

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PREFIX=volcano.
KAFKA_CLIENT_ID=volcano-hl7-mllp
KAFKA_ACK_TIMEOUT_MS=5000

# Kafka Topic Naming Strategy
# Determines which HL7 fields are used to generate Kafka topic names
# Values: legacy | message_structure
#
# legacy (default):
#   - Uses MSH-9.1 (message type) and MSH-9.2 (trigger event)
#   - Topic format: {prefix}hl7.v2.{type}.{event}
#   - Example: volcano.hl7.v2.adt.a01
#   - Compatible with HL7 v2.x (all versions including pre-v2.5)
#   - Best for environments with older HL7 v2 messages that may not have MSH-9.3
#
# message_structure:
#   - Uses MSH-9.3 (message structure)
#   - Topic format: {prefix}hl7.v2.{structure}
#   - Example: volcano.hl7.v2.adt_a01
#   - Required for HL7 v2.5 and later (MSH-9.3 is required starting in v2.5)
#   - More precise routing as structure combines type and event information
#
# structure:
#   - Uses MSH-9.3 (message structure)
#   - Topic format: {prefix}{structure} (no `hl7.v2.` infix)
#   - Example: with KAFKA_TOPIC_PREFIX=volcano.producer.hl7.cgm.medico.
#     produces volcano.producer.hl7.cgm.medico.adt_a01
#   - Use this when the prefix already encodes the protocol/version segments
#     (typical for hierarchical schemas: <env>.<producer-class>.<protocol>.<sender>.).
#
KAFKA_TOPIC_NAME=legacy

# SASL Authentication (SCRAM-SHA-512)
# Set to true to enable SASL authentication
KAFKA_SASL_ENABLED=false
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=your-username
KAFKA_SASL_PASSWORD=your-password

# SSL/TLS Configuration
# Set to true to enable SSL/TLS encryption for Kafka connections
# When both SASL and SSL are enabled, the connector uses SASL_SSL security protocol
KAFKA_SSL_ENABLED=false
KAFKA_SSL_TRUSTSTORE_LOCATION=/path/to/ca-cert.pem
KAFKA_SSL_TRUSTSTORE_TYPE=PEM
# Note: PEM files don't require passwords. Use JKS or PKCS12 for encrypted keystores.
