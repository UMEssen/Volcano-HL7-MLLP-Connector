# Volcano HL7 MLLP Connector Configuration
# Copy this file to .env and update with your values

# MLLP Server Configuration
MLLP_PORT=2575
MLLP_TLS=false

# HL7 Message Encoding
# Character encoding for HL7 messages (UTF-8, ISO-8859-1, windows-1252, US-ASCII)
# Default: UTF-8 (recommended for international characters like ä, ö, ü, ß).
# German hospital feeds are commonly windows-1252 (a superset of ISO-8859-1).
# NOTE: MSH-18 (declared charset) is ignored — set this to match what the
# sender actually emits.
HL7_ENCODING=UTF-8
# Set to false to drop the (large) raw ER7 string from the JSON envelope.
HL7_INCLUDE_RAW=true

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# --- Topic routing ---
# Preferred: STATIC topic. Set KAFKA_TOPIC to route every message from this
# instance to one fixed topic. Use this when the deployment unit is a "feed"
# (e.g. one upstream source/stream): topic identity comes from the feed you
# control, not the message type the upstream can change. MSH-9 then only feeds
# the key/headers/metadata.
#   KAFKA_TOPIC=volcano.producer.hl7.v2.<system>.<feed>
KAFKA_TOPIC=
# Fallback (used only when KAFKA_TOPIC is empty): derive
# {prefix}{infix}{type}.{event} from MSH-9.1 / MSH-9.2.
KAFKA_TOPIC_PREFIX=volcano.
KAFKA_TOPIC_INFIX=hl7.v2.
KAFKA_CLIENT_ID=volcano-hl7-mllp
KAFKA_ACK_TIMEOUT_MS=5000
# Producer sizing. Default Kafka max.request.size is 1 MiB and silently
# rejects document-bearing HL7 (MDM, ORU with PDFs) — keep this >= the topic's
# max.message.bytes. The JSON envelope inflates the raw HL7 ~2-3x.
KAFKA_MAX_REQUEST_SIZE=10485760
KAFKA_BUFFER_MEMORY=67108864
KAFKA_COMPRESSION_TYPE=lz4

# Observability — Prometheus metrics + health on a separate HTTP port.
# /metrics (Prometheus text), /healthz (liveness). Scrape the metrics port.
METRICS_ENABLED=true
METRICS_PORT=9404

# SASL Authentication (SCRAM-SHA-512)
# Set to true to enable SASL authentication
KAFKA_SASL_ENABLED=false
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=your-username
KAFKA_SASL_PASSWORD=your-password

# SSL/TLS Configuration
# Set to true to enable SSL/TLS encryption for Kafka connections
# When both SASL and SSL are enabled, the connector uses SASL_SSL security protocol
KAFKA_SSL_ENABLED=false
KAFKA_SSL_TRUSTSTORE_LOCATION=/path/to/ca-cert.pem
KAFKA_SSL_TRUSTSTORE_TYPE=PEM
# Note: PEM files don't require passwords. Use JKS or PKCS12 for encrypted keystores.
